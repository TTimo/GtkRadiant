#!/bin/bash
#
# GtkRadiant.app launcher: point GLib, GTK3, gdk-pixbuf and fontconfig at the
# runtime inside the bundle, then run radiant.bin.
#

contents="$( cd "$( dirname "$0" )/.." && pwd )"
resources="${contents}/Resources"

# Use only the bundled runtime, never modules or data from a Homebrew install:
# loading those would pull a second copy of GLib into the process.
export XDG_DATA_DIRS="${resources}/share"
export GSETTINGS_SCHEMA_DIR="${resources}/share/glib-2.0/schemas"
export GIO_MODULE_DIR="${resources}/lib/gio/modules"
export GTK_PATH="${resources}/lib/gtk-3.0"
export GTK_EXE_PREFIX="${resources}"
export GTK_DATA_PREFIX="${resources}"
export GTK_IM_MODULE_FILE="${resources}/etc/gtk-3.0/immodules.cache"
export FONTCONFIG_FILE="${resources}/etc/fonts/fonts.conf"

# gdk-pixbuf needs absolute loader paths, so the cache is generated per launch
cache_dir="${TMPDIR:-/tmp}/GtkRadiant"
mkdir -p "${cache_dir}"
sed "s:@RESOURCES@:${resources}:g" "${resources}/etc/gdk-pixbuf-loaders.cache.in" > "${cache_dir}/loaders.cache"
export GDK_PIXBUF_MODULE_FILE="${cache_dir}/loaders.cache"

# older macOS passes a process serial number, which radiant would take for a project file
args=()
for arg in "$@"; do
	case "${arg}" in
		-psn_*) ;;
		*) args+=( "${arg}" ) ;;
	esac
done

cd "${resources}/install"
exec ./radiant.bin "${args[@]}"
